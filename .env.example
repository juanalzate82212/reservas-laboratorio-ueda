# Plantilla de variables de entorno. Copiar a `.env` y rellenar.
# El `.env` está en .gitignore y NUNCA se commitea. En Vercel estos valores van
# en Settings → Environment Variables (entornos Production y Preview).

# ---- Base de datos (Supabase) ----
# Son DOS cadenas distintas y no son intercambiables (§2.2 del plan).
#
# DATABASE_URL  → Transaction pooler, puerto 6543. La usa la app en runtime.
#                 Los parámetros del final son obligatorios: sin ellos aparece
#                 "prepared statement already exists" en producción.
# DIRECT_URL    → Conexión directa, puerto 5432. Solo para `prisma migrate`,
#                 porque PgBouncer en modo transacción no soporta DDL.
#
# `connection_limit=1` en DATABASE_URL es lo correcto para Vercel (cada
# invocación serverless solo necesita una conexión, y así no se agota el cupo
# compartido del pooler entre muchas invocaciones a la vez). NO lo cambies en
# producción. En LOCAL, sin embargo, es un único proceso de larga duración
# (`next dev`) compitiendo solo consigo mismo: si notas que abrir dos
# calendarios a la vez tarda varios segundos, puedes subirlo a
# `connection_limit=5` (o similar) SOLO en tu `.env` local — nunca en las
# variables de entorno de Vercel.
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ---- Sesión de administrador ----
ADMIN_PASSWORD="cambiar-por-una-contrasena-fuerte"
# Generar con: openssl rand -base64 32
AUTH_SECRET="cadena-aleatoria-de-32-bytes"

# ---- URL pública (la que codifica el QR) ----
# En Vercel debe ser el dominio final: un valor incorrecto rompe el QR.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Correo (Google Workspace). Ver §10 del plan. ----
# Si falta SMTP_HOST o SMTP_PASSWORD (lib/mail/mailer.ts revisa ambos, no solo
# el host), el mailer escribe en consola y registra en EmailLog con estado
# LOGGED, en vez de fallar. Sirve para desarrollar sin la contraseña de
# aplicación de Google todavía tramitada (§10.2).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="lab.analitica@amigo.edu.co"
# Contraseña de aplicación de 16 caracteres, SIN espacios.
SMTP_PASSWORD=""
# Debe coincidir con SMTP_USER (o ser un alias suyo): Gmail rechaza remitentes
# arbitrarios.
MAIL_FROM="Laboratorio de Analítica de Datos e Inteligencia Artificial <lab.analitica@amigo.edu.co>"
