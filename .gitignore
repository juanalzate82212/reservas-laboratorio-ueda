# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
# El orden importa: la negación va AL FINAL del bloque, porque en .gitignore
# gana el último patrón que coincide. Antes había un `.env*` suelto más abajo
# que volvía a ignorar .env.example y dejaba muerta esta excepción; el fichero
# seguía versionado solo porque se añadió antes de que apareciera ese patrón.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# skills de agente (contenido de terceros, no código del proyecto)
# skills-lock.json SÍ se versiona: guarda de qué repo y con qué hash viene
# cada una, igual que package-lock.json para node_modules. El árbol de
# ficheros es caché reinstalable, y estaba DUPLICADO — en esta máquina
# .claude/skills/ son junctions de Windows hacia .agents/skills/, pero git
# no los sigue como enlaces y guardaba las dos copias (~230 ficheros).
.claude/skills/
.agents/skills/
